  "strings": {
    "%@: pausing Hot Corners…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pausing Hot Corners…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：正在暫停熱角⋯"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：ホットコーナーを停止しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 핫 코너를 일시 정지하는 중…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pausando esquinas activas…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pausando Cantos Ativos…"
          }
        }
      }
    },
    "%@: pausing is turned off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pausing is turned off"
