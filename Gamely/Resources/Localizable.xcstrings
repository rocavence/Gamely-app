          }
        }
      }
    },
    "Some games never turn on Game Mode, such as Windows games running through CrossOver, Whisky or some Steam titles. Add them here: Hot Corners pause whenever one of them is in front.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some games never turn on Game Mode, such as Windows games running through CrossOver, Whisky or some Steam titles. Add them here: Hot Corners pause whenever one of them is in front."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些遊戲不會開啟遊戲模式，例如透過 CrossOver、Whisky 執行的 Windows 遊戲，以及部分 Steam 遊戲。把它們加在這裡，只要其中一個在最前面，熱角就會暫停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver や Whisky で動く Windows ゲームや一部の Steam タイトルなど、ゲームモードをオンにしないゲームがあります。ここに追加すると、いずれかが最前面にあるあいだホットコーナーを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CrossOver나 Whisky로 실행하는 Windows 게임, 일부 Steam 게임처럼 게임 모드를 켜지 않는 게임이 있습니다. 여기에 추가하면 그중 하나가 맨 앞에 있을 때마다 핫 코너가 일시 정지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos juegos nunca activan el modo de juego, como los de Windows que se ejecutan con CrossOver o Whisky, o ciertos títulos de Steam. Añádelos aquí: las esquinas activas se pausan cuando alguno está en primer plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns jogos nunca ativam o Modo Jogo, como jogos de Windows rodando pelo CrossOver ou Whisky e alguns títulos da Steam. Adicione-os aqui: os Cantos Ativos pausam sempre que um deles estiver em primeiro plano."
          }
        }
      }
    },
    "Start Gamely when you log in, so it's there before your first game.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Gamely when you log in, so it's there before your first game."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時就啟動 Gamely，開第一場遊戲前就準備好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に Gamely を起動して、最初のゲームに備えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 때 Gamely를 실행해 첫 게임 전에 준비해 둡니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Gamely al iniciar sesión, para que esté listo antes de tu primera partida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Gamely ao iniciar a sessão, para que esteja pronto antes do primeiro jogo."
          }
        }
      }
    },
