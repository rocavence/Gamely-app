        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：停止機能はオフです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 일시 정지가 꺼져 있음"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: la pausa está desactivada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a pausa está desligada"
          }
        }
      }
    },
