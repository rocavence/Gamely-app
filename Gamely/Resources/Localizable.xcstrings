    "Choose the games or launchers that should pause Hot Corners.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the games or launchers that should pause Hot Corners."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要暫停熱角的遊戲或啟動器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットコーナーを停止させたいゲームやランチャーを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핫 코너를 일시 정지할 게임이나 런처를 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los juegos o lanzadores que deben pausar las esquinas activas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os jogos ou launchers que devem pausar os Cantos Ativos."
          }
        }
      }
    },
    "Couldn't check for updates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check for updates."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 확인할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron buscar actualizaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar atualizações."
          }
        }
      }
    },
    "Couldn't turn this on: %@ Open Login Items in System Settings and allow Gamely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't turn this on: %@ Open Login Items in System Settings and allow Gamely."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟：%@ 請到「系統設定」的「登入項目」允許 Gamely。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにできませんでした：%@ システム設定の“ログイン項目”で Gamely を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켤 수 없음: %@ 시스템 설정의 로그인 항목에서 Gamely를 허용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo activar: %@ Abre Ítems de inicio en Ajustes del Sistema y permite Gamely."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar: %@ Abra Itens de Início nos Ajustes do Sistema e permita o Gamely."
          }
        }
      }
    },
