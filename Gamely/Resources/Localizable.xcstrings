    "macOS is waiting for your OK: open Login Items in System Settings and allow Gamely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for your OK: open Login Items in System Settings and allow Gamely."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 在等你同意：到「系統設定」的「登入項目」允許 Gamely。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が許可を待っています。システム設定の“ログイン項目”で Gamely を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 승인을 기다리고 있습니다. 시스템 설정의 로그인 항목에서 Gamely를 허용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS espera tu permiso: abre Ítems de inicio en Ajustes del Sistema y permite Gamely."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS está aguardando sua permissão: abra Itens de Início nos Ajustes do Sistema e permita o Gamely."
          }
        }
      }
    },
